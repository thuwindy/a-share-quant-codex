# Copy to .env or export these variables in your shell.
# Never commit real API keys or tokens.

# Tushare
TUSHARE_TOKEN=
TUSHARE_BYPASS_SYSTEM_PROXY=1

# LLM provider, compatible with OpenAI-style chat-completions endpoints.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_REQUEST_TIMEOUT_SECONDS=60
LLM_RETRIES=1

# PushPlus, optional notification delivery.
PUSHPLUS_TOKEN=
PUSHPLUS_TOPIC=
PUSHPLUS_CHANNEL=wechat

